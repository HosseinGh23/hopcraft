{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HopCraft",
  "version": "1.2.0",
  "identifier": "com.hosseingh23.hopcraft",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "HopCraft \u2014 Xray Proxy Chain JSON Generator",
        "width": 880,
        "height": 740,
        "minWidth": 740,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
